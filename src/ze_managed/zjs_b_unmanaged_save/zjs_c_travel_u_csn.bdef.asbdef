projection;
strict ( 2 );
use draft;

define behavior for ZJS_C_TRAVEL_U_CSN alias Travel
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Booking { create; with draft; }
}

define behavior for ZJS_C_BOOKING_U_CSN alias Booking
{
  use update;
  use delete;

  use association _Travel { with draft; }
}