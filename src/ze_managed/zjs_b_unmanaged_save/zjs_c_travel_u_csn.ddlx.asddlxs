    EndDate;

    @UI.lineItem: [{ position: 60, label: 'Booking Fee' }]
    @UI.identification: [{ position: 70, label: 'Booking Fee' }]
    BookingFee;

    @UI.lineItem: [{ position: 70, label: 'Total Price' }]
